From 744ce9afe50b7a7238d401e658b0f1ccf17c0289 Mon Sep 17 00:00:00 2001
From: Adam Polkosnik <apolkosnik@gmail.com>
Date: Tue, 27 Oct 2026 21:55:31 -0400
Subject: [PATCH 4/5] Minimig: the cartridge, HRTmon or the Action Replay, as
 on Maximig

The System menu's HRTmon item becomes "Cartridge: Off / HRTmon / Action
Replay" for Minimig too.  The Action Replay (AR5.ROM, the DeMoN v2 build)
goes to $A80000; Minimig takes the choice from ext_cfg bit 23 (its status
bit 55: bits 21-22 are its CD speed), Maximig from bit 21 as before
(minimig_cart_ar_bit).  The type is sent to the core with the CPU halted,
before the image, for both.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 menu.cpp                           | 37 +++++++++++-------------------
 support/minimig/minimig_config.cpp | 12 ++++++----
 support/minimig/minimig_config.h   |  8 +++++++
 3 files changed, 29 insertions(+), 28 deletions(-)

diff --git a/menu.cpp b/menu.cpp
index da9a371..63c2f78 100644
--- a/menu.cpp
+++ b/menu.cpp
@@ -6768,7 +6768,7 @@ void HandleUI(void)
 				fastcfg ? config_memory_fast_msg[((minimig_config.cpu & 0x23) != 0x23 && (minimig_config.cpu & 2)) ? 1 : 0][fastcfg] : "",
 				((minimig_config.memory >> 2) & 0x03) ? "+" : "",
 				((minimig_config.memory >> 2) & 0x03) ? config_memory_slow_msg[(minimig_config.memory >> 2) & 0x03] : "",
-				(minimig_config.memory & 0x40) ? ((is_maximig() && (minimig_get_extcfg() & MAXIMIG_EXTCFG_AR)) ? " AR" : " HRT") : ""
+				(minimig_config.memory & 0x40) ? ((minimig_get_extcfg() & minimig_cart_ar_bit()) ? " AR" : " HRT") : ""
 			);
 
 			char *p = strrchr(minimig_config.kickstart, '/');
@@ -6939,18 +6939,10 @@ void HandleUI(void)
 			}
 		}
 		OsdWrite(m++, s, menusub == 6, 0);
-		if (is_maximig())
-		{
-			// the cartridge: HRTmon or the Action Replay (AR5, DeMoN v2)
-			strcpy(s, " Cartridge: ");
-			strcat(s, !(minimig_config.memory & 0x40) ? "Off" :
-				(minimig_get_extcfg() & MAXIMIG_EXTCFG_AR) ? "Action Replay" : "HRTmon");
-		}
-		else
-		{
-			strcpy(s, " HRTmon   : ");
-			strcat(s, (minimig_config.memory & 0x40) ? "Enabled" : "Disabled");
-		}
+		// the cartridge: HRTmon or the Action Replay (AR5, DeMoN v2)
+		strcpy(s, " Cartridge: ");
+		strcat(s, !(minimig_config.memory & 0x40) ? "Off" :
+			(minimig_get_extcfg() & minimig_cart_ar_bit()) ? "Action Replay" : "HRTmon");
 		OsdWrite(m++, s, menusub == 7, 0);
 
 		OsdWrite(m++, "", 0, 0);
@@ -7140,17 +7132,14 @@ void HandleUI(void)
 			}
 			else if (menusub == 7)
 			{
-				if (is_maximig())
-				{
-					// Off -> HRTmon -> Action Replay -> Off; kept in the config and
-					// sent to the core at the next reset, with the cartridge's image
-					int c = !(minimig_config.memory & 0x40) ? 0 : (minimig_get_extcfg() & MAXIMIG_EXTCFG_AR) ? 2 : 1;
-					c = (c + (minus ? 2 : 1)) % 3;
-					minimig_config.memory = (minimig_config.memory & ~0x40) | (c ? 0x40 : 0);
-					if (c == 2) minimig_config.ext_cfg2 |= MAXIMIG_EXTCFG_AR >> 16;
-					else minimig_config.ext_cfg2 &= ~(MAXIMIG_EXTCFG_AR >> 16);
-				}
-				else minimig_config.memory ^= 0x40;
+				// Off -> HRTmon -> Action Replay -> Off; kept in the config and
+				// sent to the core at the next reset, with the cartridge's image
+				unsigned int arbit = minimig_cart_ar_bit();
+				int c = !(minimig_config.memory & 0x40) ? 0 : (minimig_get_extcfg() & arbit) ? 2 : 1;
+				c = (c + (minus ? 2 : 1)) % 3;
+				minimig_config.memory = (minimig_config.memory & ~0x40) | (c ? 0x40 : 0);
+				if (c == 2) minimig_config.ext_cfg2 |= arbit >> 16;
+				else minimig_config.ext_cfg2 &= ~(arbit >> 16);
 				menustate = MENU_MINIMIG_CHIPSET1;
 			}
 			else if (menusub == 9)
diff --git a/support/minimig/minimig_config.cpp b/support/minimig/minimig_config.cpp
index 369eb02..fcfdf24 100644
--- a/support/minimig/minimig_config.cpp
+++ b/support/minimig/minimig_config.cpp
@@ -291,10 +291,15 @@ static char UploadKickstart(char *name)
 	return(0);
 }
 
+unsigned int minimig_cart_ar_bit()
+{
+	return is_maximig() ? MAXIMIG_EXTCFG_AR : MINIMIG_EXTCFG_AR;
+}
+
 static char UploadActionReplay()
 {
 	fileTYPE file = {};
-	if (is_maximig() && (minimig_get_extcfg() & MAXIMIG_EXTCFG_AR))
+	if (minimig_get_extcfg() & minimig_cart_ar_bit())
 	{
 		// the Action Replay: AR5's DeMoN v2 build, its ROM ($A80000) and RAM
 		// ($AC0000) image, 512 KB at most; it takes no configuration
@@ -492,9 +497,8 @@ static void ApplyConfiguration(char reloadkickstart)
 	minimig_ConfigFloppy(minimig_config.floppy.drives, minimig_config.floppy.speed);
 	minimig_ConfigFloppyExt(minimig_config.externalfloppy.exDrives[0], minimig_config.externalfloppy.exDrives[1], minimig_config.externalfloppy.exDrives[2], minimig_config.externalfloppy.exDrives[3]);
 
-	// Maximig: the cartridge's type before its image goes up, while the CPU
-	// is halted
-	if (is_maximig()) minimig_set_extcfg(minimig_get_extcfg() & ~1);
+	// the cartridge's type before its image goes up, while the CPU is halted
+	minimig_set_extcfg(minimig_get_extcfg() & ~1);
 	if (minimig_config.memory & 0x40) UploadActionReplay();
 
 	if (reloadkickstart)
diff --git a/support/minimig/minimig_config.h b/support/minimig/minimig_config.h
index fa9bef9..f4bd551 100644
--- a/support/minimig/minimig_config.h
+++ b/support/minimig/minimig_config.h
@@ -21,6 +21,10 @@
 // core's status bit 54, taken at the next reset
 #define MAXIMIG_EXTCFG_BFG 0x400000
 
+// Minimig: the same choice of cartridge, the core's status bit 55 (bits 21
+// and 22 are the CD speed there)
+#define MINIMIG_EXTCFG_AR 0x800000
+
 #define CONFIG_FLOPPY1X  0
 #define CONFIG_FLOPPY2X  1
 
@@ -102,6 +106,10 @@ int minimig_cfg_save(int num);
 const char* minimig_get_cfg_info(int num, int label);
 
 void minimig_reset();
+
+// the cartridge (memory bit 6) is the Action Replay, not HRTmon: the ext_cfg
+// bit the core (Minimig or Maximig) takes it from
+unsigned int minimig_cart_ar_bit();
 void minimig_set_kickstart(const char *name);
 void minimig_set_extrom(const char *name);
 const char* minimig_get_extrom();
-- 
2.56.0

