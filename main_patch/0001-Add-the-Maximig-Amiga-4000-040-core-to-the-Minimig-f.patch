From e9514705d213ab5d7384ce257f5a85f6451ba831 Mon Sep 17 00:00:00 2001
From: Adam Polkosnik <apolkosnik@gmail.com>
Date: Fri, 23 Oct 2026 14:11:51 -0400
Subject: [PATCH 1/5] Add the Maximig (Amiga 4000/040) core to the Minimig
 family

The Maximig core speaks the Minimig protocol: is_minimig() takes its name,
its media share games/Amiga, and its System menu shows what the A4000 has --
the 68040's clock (25 MHz as on the A3640, 33, 50, 56 MHz) and bus timing
(A4000 or Fast), the motherboard RAM (Ramsey, up to 16 MB) and the Zorro III
RAM board -- in place of Minimig's CPU, chipset and RAM choices.  CD32/CDTV
drives are not offered.  A new configuration defaults to 2 MB chip RAM,
16 MB motherboard RAM, a 25 MHz 68040, AGA and KICK4000.ROM.

Rebased onto master's System menu (no D-Cache row, five upper indices):
CPU 0, Bus 1, ChipRAM 2 (fixed), Z3 RAM 3, MB RAM 4; Chipset AGA has no
row of its own, so ROM and what follows keep Minimig's indices.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 menu.cpp                           | 90 +++++++++++++++++++++++-------
 support/minimig/minimig_config.cpp | 14 ++++-
 user_io.cpp                        | 10 +++-
 user_io.h                          |  1 +
 4 files changed, 92 insertions(+), 23 deletions(-)

diff --git a/menu.cpp b/menu.cpp
index dbedb16..8b28702 100644
--- a/menu.cpp
+++ b/menu.cpp
@@ -6867,24 +6867,49 @@ void HandleUI(void)
 		parentstate = menustate;
 
 		m = 0;
-		strcpy(s, " CPU      : ");
-		strcat(s, ((minimig_config.cpu & 0x23) == 0x23) ? "68EC020" : ((minimig_config.cpu & 0x23) == 0x22) ? "68EC030" : config_cpu_msg[minimig_config.cpu & 0x03]);
-		if ((minimig_config.cpu & 0x03) == 0x02) strcat(s, ((minimig_config.cpu & 0xc0) == 0x40) ? " 40MHz" : ((minimig_config.cpu & 0xc0) == 0x80) ? " 50MHz" : " Fast");
-		OsdWrite(m++, s, menusub == 0, 0);
+		if (is_maximig())
+		{
+			// the Amiga 4000/040: the 68040's clock and bus timing, the
+			// motherboard's RAM and the Zorro III RAM board (the rows keep
+			// Minimig's five indices: ROM and what follows line up)
+			static const char *mx_speed[] = { "25MHz (A3640)", "33MHz", "50MHz", "56MHz" };
+			static const char *mx_mbram[] = { "none", "4M", "8M", "16M" };
+			int z3 = ((minimig_config.memory >> 4) & 0x03) | ((minimig_config.memory & 0x80) >> 5);
 
-		OsdWrite(m++, "", 0, 0);
-		strcpy(s, " Chipset  : ");
-		strcat(s, config_chipset_msg[(minimig_config.chipset >> 2) & 7]);
-		OsdWrite(m++, s, menusub == 1, 0);
-		strcpy(s, " ChipRAM  : ");
-		strcat(s, config_memory_chip_msg[minimig_config.memory & 0x03]);
-		OsdWrite(m++, s, menusub == 2, 0);
-		strcpy(s, " FastRAM  : ");
-		strcat(s, config_memory_fast_msg[((minimig_config.cpu & 0x23) != 0x23 && (minimig_config.cpu & 2)) ? 1 : 0][((minimig_config.memory >> 4) & 0x03) | ((minimig_config.memory & 0x80) >> 5)]);
-		OsdWrite(m++, s, menusub == 3, 0);
-		strcpy(s, " SlowRAM  : ");
-		strcat(s, config_memory_slow_msg[(minimig_config.memory >> 2) & 0x03]);
-		OsdWrite(m++, s, menusub == 4, 0);
+			sprintf(s, " CPU      : 68040 %s", mx_speed[minimig_config.cpu & 0x03]);
+			OsdWrite(m++, s, menusub == 0, 0);
+			sprintf(s, " Bus      : %s", (minimig_config.cpu & 0x20) ? "Fast" : "A4000");
+			OsdWrite(m++, s, menusub == 1, 0);
+
+			OsdWrite(m++, "", 0, 0);
+			OsdWrite(m++, " Chipset  : AGA", 0, 1);
+			OsdWrite(m++, " ChipRAM  : 2M", menusub == 2, 1);
+			sprintf(s, " Z3 RAM   : %s", !z3 ? "none" : (z3 < 4) ? "128M" : (z3 == 4) ? "256M" : "384M");
+			OsdWrite(m++, s, menusub == 3, 0);
+			sprintf(s, " MB RAM   : %s", mx_mbram[(minimig_config.memory >> 2) & 0x03]);
+			OsdWrite(m++, s, menusub == 4, 0);
+		}
+		else
+		{
+			strcpy(s, " CPU      : ");
+			strcat(s, ((minimig_config.cpu & 0x23) == 0x23) ? "68EC020" : ((minimig_config.cpu & 0x23) == 0x22) ? "68EC030" : config_cpu_msg[minimig_config.cpu & 0x03]);
+			if ((minimig_config.cpu & 0x03) == 0x02) strcat(s, ((minimig_config.cpu & 0xc0) == 0x40) ? " 40MHz" : ((minimig_config.cpu & 0xc0) == 0x80) ? " 50MHz" : " Fast");
+			OsdWrite(m++, s, menusub == 0, 0);
+
+			OsdWrite(m++, "", 0, 0);
+			strcpy(s, " Chipset  : ");
+			strcat(s, config_chipset_msg[(minimig_config.chipset >> 2) & 7]);
+			OsdWrite(m++, s, menusub == 1, 0);
+			strcpy(s, " ChipRAM  : ");
+			strcat(s, config_memory_chip_msg[minimig_config.memory & 0x03]);
+			OsdWrite(m++, s, menusub == 2, 0);
+			strcpy(s, " FastRAM  : ");
+			strcat(s, config_memory_fast_msg[((minimig_config.cpu & 0x23) != 0x23 && (minimig_config.cpu & 2)) ? 1 : 0][((minimig_config.memory >> 4) & 0x03) | ((minimig_config.memory & 0x80) >> 5)]);
+			OsdWrite(m++, s, menusub == 3, 0);
+			strcpy(s, " SlowRAM  : ");
+			strcat(s, config_memory_slow_msg[(minimig_config.memory >> 2) & 0x03]);
+			OsdWrite(m++, s, menusub == 4, 0);
+		}
 
 		OsdWrite(m++, "", 0, 0);
 		strcpy(s, " ROM      : ");
@@ -6932,7 +6957,34 @@ void HandleUI(void)
 	case MENU_MINIMIG_CHIPSET2:
 		saved_menustate = MENU_MINIMIG_CHIPSET1;
 
-		if (select || minus || plus)
+		if ((select || minus || plus) && is_maximig() && menusub <= 4)
+		{
+			if (menusub == 0)
+			{
+				minimig_config.cpu = (minimig_config.cpu & ~0x03) | ((minimig_config.cpu + (minus ? 3 : 1)) & 0x03);
+				minimig_ConfigCPU(minimig_config.cpu);
+			}
+			else if (menusub == 1)
+			{
+				minimig_config.cpu ^= 0x20;
+				minimig_ConfigCPU(minimig_config.cpu);
+			}
+			else if (menusub == 3)
+			{
+				// none, 128 MB, 256 MB, 384 MB
+				static const int z3_steps[4] = { 0, 1, 4, 5 };
+				int c = ((minimig_config.memory >> 4) & 0x03) | ((minimig_config.memory & 0x80) >> 5);
+				int k = (c == 0) ? 0 : (c < 4) ? 1 : (c == 4) ? 2 : 3;
+				c = z3_steps[(k + (minus ? 3 : 1)) & 3];
+				minimig_config.memory = ((c << 4) & 0x30) | ((c << 5) & 0x80) | (minimig_config.memory & ~0xB0);
+			}
+			else if (menusub == 4)
+			{
+				minimig_config.memory = ((minimig_config.memory + (minus ? -4 : 4)) & 0x0C) | (minimig_config.memory & ~0x0C);
+			}
+			menustate = MENU_MINIMIG_CHIPSET1;
+		}
+		else if (select || minus || plus)
 		{
 			if (menusub == 0)
 			{
@@ -7131,7 +7183,7 @@ void HandleUI(void)
 
 			MenuWrite(m++, "", 0, 0);
 
-			if (is_minimig() == 2)
+			if (is_minimig() == 2 && !is_maximig())
 			{
 				int cd32_on = minimig_config.cd32_drive.cfg ? 1 : 0;
 				int cdtv_on = minimig_config.cdtv_drive.cfg ? 1 : 0;
diff --git a/support/minimig/minimig_config.cpp b/support/minimig/minimig_config.cpp
index 896ebbc..ce1a6bd 100644
--- a/support/minimig/minimig_config.cpp
+++ b/support/minimig/minimig_config.cpp
@@ -321,7 +321,9 @@ static char UploadActionReplay()
 		spi8((data >> 0) & 0xff);
 		data = (minimig_config.ide_cfg & 1) ? 0xff : 0; // ide, 1 byte
 		spi8((data >> 0) & 0xff);
-		data = 0xff; // a1200, 1 byte
+		// a1200, 1 byte: Gayle's IDE ($DA2000); the A4000 has its own
+		// ($DD2020), which HRTmon drives when this is 0
+		data = is_maximig() ? 0x00 : 0xff;
 		spi8((data >> 0) & 0xff);
 		data = minimig_config.chipset&CONFIG_AGA ? 0xff : 0; // aga, 1 byte
 		spi8((data >> 0) & 0xff);
@@ -594,9 +596,17 @@ int minimig_cfg_load(int num)
 		minimig_config.memory = 0x11;
 		minimig_config.cpu = 0;
 		minimig_config.chipset = 0;
+		if (is_maximig())
+		{
+			// an A4000/040: 2 MB chip RAM, 16 MB motherboard RAM, 68040 at
+			// 25 MHz with A4000 bus timing, AGA, the A4000 Kickstart
+			snprintf(minimig_config.kickstart, sizeof(minimig_config.kickstart) - 1, "%s/%s", HomeDir(), "KICK4000.ROM");
+			minimig_config.memory = 0x0F;
+			minimig_config.chipset = CONFIG_AGA | CONFIG_ECS;
+		}
 		minimig_config.floppy.speed = CONFIG_FLOPPY2X;
 		minimig_config.floppy.drives = 1;
-		minimig_config.ide_cfg = 0;
+		minimig_config.ide_cfg = is_maximig() ? 1 : 0;   // the A4000 has its IDE port on the board
 		minimig_config.hardfile[0].cfg = 1;
 		minimig_config.hardfile[0].filename[0] = 0;
 		minimig_config.hardfile[1].cfg = 1;
diff --git a/user_io.cpp b/user_io.cpp
index d424a51..0a3db0a 100644
--- a/user_io.cpp
+++ b/user_io.cpp
@@ -201,7 +201,7 @@ char *user_io_get_core_path(const char *suffix, int recheck)
 	static char tmp[1024] = {};
 	char *name = (ovr_name[0] && ovr_samedir) ? orig_name : core_name;
 
-	if (!suffix) suffix = (!strcasecmp(name, "minimig")) ? "Amiga" : name;
+	if (!suffix) suffix = (!strcasecmp(name, "minimig") || !strcasecmp(name, "maximig")) ? "Amiga" : name;
 	if (recheck || strcmp(old_name, suffix) || !tmp[0])
 	{
 		strcpy(old_name, suffix);
@@ -312,7 +312,7 @@ char is_minimig()
 {
 	if (!is_minimig_type)
 	{
-		is_minimig_type = (!strcasecmp(orig_name, "minimig") || !strcasecmp(orig_name, "minimigcd")) ? 1 : 2;
+		is_minimig_type = (!strcasecmp(orig_name, "minimig") || !strcasecmp(orig_name, "minimigcd") || !strcasecmp(orig_name, "maximig")) ? 1 : 2;
 		if (is_minimig_type == 1)
 		{
 			uint16_t res = spi_uio_cmd(UIO_GET_VMODE);
@@ -324,6 +324,12 @@ char is_minimig()
 	return (is_minimig_type == 1) ? 1 : (is_minimig_type == 3) ? 2 : 0;
 }
 
+// the Maximig core: an Amiga 4000/040 speaking the Minimig protocol
+char is_maximig()
+{
+	return !strcasecmp(orig_name, "maximig");
+}
+
 static int is_megacd_type = 0;
 char is_megacd()
 {
diff --git a/user_io.h b/user_io.h
index 5837f1a..3a76a70 100644
--- a/user_io.h
+++ b/user_io.h
@@ -272,6 +272,7 @@ void diskled_on();
 #define DISKLED_OFF void()
 
 char is_minimig();
+char is_maximig();
 char is_next();
 char is_falcon();
 char is_menu();
